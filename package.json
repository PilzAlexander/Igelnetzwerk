{
  "name": "igel-leitstelle",
  "private": true,
  "version": "0.1.0",
  "description": "Klickbarer Prototyp der Igel-Leitstelle (Region 10: IN, EI, ND, PAF)",
  "type": "module",
  "scripts": {
    "start": "node scripts/node-pruefen.cjs && npm install --no-audit --no-fund && vite --host",
    "dev": "node scripts/node-pruefen.cjs && vite --host",
    "build": "vite build",
    "build:datei": "vite build --mode datei && node scripts/datei-kopieren.js",
    "preview": "vite preview --host",
    "test": "node --test src/rules/rules.test.js",
    "schema-doku": "node scripts/schema-doku.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.1",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
